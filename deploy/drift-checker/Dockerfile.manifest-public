# mdf-manifest-public — serves mdf-demo's drift manifest over Tailscale.
#
# Unraid per-container Tailscale hook provides the identity; the container
# itself runs root (needed by the hook) then this entrypoint starts crond and
# nginx. It serves exactly one file (manifest.json) and regenerates it every
# 5 minutes from the mounted appdata. NO docker socket is mounted.
FROM nginx:alpine

RUN apk add --no-cache openssl bash

# Shared generator (single canonical file across every host/role)
WORKDIR /opt/mdf-drift
COPY manifest.sh /opt/mdf-drift/manifest.sh
RUN chmod +x /opt/mdf-drift/manifest.sh

# nginx: serve exactly /manifest.json; everything else 404, no listing
COPY nginx-manifest.conf /etc/nginx/conf.d/default.conf

# crond job: regenerate every 5 min from the mounted appdata
RUN mkdir -p /srv && printf '*/5 * * * * /opt/mdf-drift/manifest.sh gen /mdf-appdata /srv/manifest.json /mdf-appdata/drift-salt public >> /var/log/mdf-manifest.log 2>&1\n' > /etc/crontabs/root

COPY manifest-entrypoint.sh /opt/mdf-drift/entrypoint.sh
RUN chmod +x /opt/mdf-drift/entrypoint.sh
ENTRYPOINT ["/opt/mdf-drift/entrypoint.sh"]
