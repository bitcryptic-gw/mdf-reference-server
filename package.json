{
  "name": "mdf-server",
  "version": "0.2.3",
  "description": "MDF — Markdown First reference implementation",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test:config": "bun run src/config/loader.test.ts",
    "test:402": "bun run src/payment/402-schema.test.ts",
    "test:handler": "bun run src/content/handler.test.ts",
    "test:source-bytes": "bun run src/source-bytes.test.ts",
    "test:router": "bun run src/router.test.ts",
    "test:health": "bun run src/health.test.ts",
    "test": "bun run test:config && bun run test:402 && bun run test:handler && bun run test:source-bytes && bun run test:router && bun run test:health"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@noble/secp256k1": "^2.2.3",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "marked": "^18.0.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bun-types": "latest"
  },
  "overrides": {
    "gray-matter>js-yaml": "3.15.2"
  }
}
